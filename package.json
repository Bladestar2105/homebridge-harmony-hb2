  "description": "Publish your harmony activities as homekit accessories for homebridge-2.0.0 and later.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node -e \"import('./index.js').then(() => console.log('No syntax errors! (node ' + process.version + ')'))\""
  },
